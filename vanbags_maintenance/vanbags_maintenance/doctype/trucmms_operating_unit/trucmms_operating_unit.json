{
 "doctype": "DocType",
 "name": "TruCMMS Operating Unit",
 "module": "Vanbags Maintenance",
 "autoname": "hash",
 "allow_rename": 0,
 "track_changes": 1,
 "title_field": "unit_name",
 "show_title_field_in_link": 1,
 "search_fields": "unit_code,unit_name",
