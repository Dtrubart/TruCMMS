   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "unit_type",
   "label": "Unit Type",
   "fieldtype": "Data",
   "description": "Optional configurable label, such as Region, Division or District. No mandatory geographic levels."
  },
  {
   "fieldname": "parent_unit",
   "label": "Parent Unit",
   "fieldtype": "Link",
