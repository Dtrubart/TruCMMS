{
 "doctype": "DocType",
 "name": "TruCMMS Meter",
 "module": "Vanbags Maintenance",
 "engine": "InnoDB",
 "allow_rename": 0,
 "allow_import": 0,
 "track_changes": 1,
 "istable": 0,
 "autoname": "field:code",
 "field_order": [
  "code",
  "meter_name",
  "company",
  "site",
  "equipment",
  "component",
  "unit",
  "metric_kind",
  "direction",
  "max_age_hours",
  "disabled",
  "epoch",
  "epoch_offset",
  "last_reading"
 ],
 "fields": [
  {
   "fieldname": "code",
   "label": "Código",
   "fieldtype": "Data",
   "reqd": 1,
   "unique": 1,
   "length": 64,
   "in_list_view": 1
  },
  {
   "fieldname": "meter_name",
   "label": "Medidor",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "label": "Empresa",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "site",
   "label": "Sede",
   "fieldtype": "Link",
   "options": "TruCMMS Site",
   "reqd": 1
  },
  {
   "fieldname": "equipment",
   "label": "Equipo",
   "fieldtype": "Link",
   "options": "VB Equipment",
   "in_list_view": 1
  },
  {
   "fieldname": "component",
   "label": "Componente",
   "fieldtype": "Link",
   "options": "TruCMMS Component"
  },
  {
   "fieldname": "unit",
   "label": "Unidad",
   "fieldtype": "Link",
   "options": "UOM",
   "reqd": 1
  },
  {
   "fieldname": "metric_kind",
   "label": "Tipo",
   "fieldtype": "Select",
   "options": "Cumulative\nCondition\nRate",
   "default": "Cumulative",
   "reqd": 1
  },
  {
   "fieldname": "direction",
   "label": "Comportamiento",
   "fieldtype": "Select",
   "options": "Increasing\nDecreasing\nVariable",
   "default": "Increasing",
   "reqd": 1
  },
  {
   "fieldname": "max_age_hours",
   "label": "Antigüedad máxima (horas)",
   "fieldtype": "Float",
   "default": "168"
  },
  {
   "fieldname": "disabled",
   "label": "Deshabilitado",
   "fieldtype": "Check"
  },
  {
   "fieldname": "epoch",
   "label": "Época",
   "fieldtype": "Int",
   "default": "1",
   "read_only": 1
  },
  {
   "fieldname": "epoch_offset",
   "label": "Continuidad acumulada",
   "fieldtype": "Float",
   "precision": "6",
   "read_only": 1
  },
  {
   "fieldname": "last_reading",
   "label": "Última lectura",
   "fieldtype": "Link",
   "options": "TruCMMS Meter Reading",
   "read_only": 1
  }
 ],
 "title_field": "meter_name",
 "permissions": [
  {
   "role": "TruCMMS Dispatcher",
   "read": 1,
   "select": 1,
   "report": 1,
   "create": 0,
   "write": 0
  },
  {
   "role": "TruCMMS Supervisor",
   "read": 1,
   "select": 1,
   "report": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "TruCMMS Technician",
   "read": 1,
   "select": 1,
   "report": 1,
   "create": 0,
   "write": 0
  },
  {
   "role": "System Manager",
   "read": 1,
   "select": 1,
   "report": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "VB Maintenance Manager",
   "read": 1,
   "select": 1,
   "report": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "VB Maintenance User",
   "read": 1,
   "select": 1,
   "report": 1,
   "create": 0,
   "write": 0
  }
 ]
}
