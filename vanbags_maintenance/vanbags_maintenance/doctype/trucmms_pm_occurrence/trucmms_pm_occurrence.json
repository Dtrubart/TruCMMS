   "options": "Planned\nReleased\nCompleted\nSkipped\nCancelled",
   "default": "Planned",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "work_order",
   "label": "Orden liberada",
   "fieldtype": "Link",
   "options": "TruCMMS Maintenance Work Order",
   "unique": 1,
   "read_only": 1
  },
  {
   "fieldname": "trigger_reading",
   "label": "Lectura de origen",
   "fieldtype": "Link",
   "options": "TruCMMS Meter Reading",
   "read_only": 1
