{
 "doctype": "DocType",
 "name": "TruCMMS PM Occurrence",
 "module": "Vanbags Maintenance",
 "engine": "InnoDB",
 "allow_rename": 0,
 "allow_import": 0,
 "track_changes": 1,
 "istable": 0,
 "autoname": "field:occurrence_key",
 "field_order": [
  "occurrence_key",
  "plan",
  "company",
  "site",
  "equipment",
  "component",
  "subject",
  "original_due",
  "planned_for",
  "status",
  "work_order",
  "trigger_reading",
  "trigger_total",
  "source_key",
  "sequence",
  "procedure_snapshot",
  "last_reason",
  "baseline_before",
  "completed_actual_on",
  "completion_reading",
  "recorded_on"
 ],
 "fields": [
