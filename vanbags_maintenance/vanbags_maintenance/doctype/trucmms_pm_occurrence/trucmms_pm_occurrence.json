   "fieldtype": "Data",
   "unique": 1,
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "plan",
   "label": "Plan",
   "fieldtype": "Link",
   "options": "TruCMMS PM Plan",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "company",
   "label": "Empresa",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "site",
   "label": "Sede",
   "fieldtype": "Link",
   "options": "TruCMMS Site",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "equipment",
   "label": "Equipo",
   "fieldtype": "Link",
   "options": "VB Equipment",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "component",
   "label": "Componente",
   "fieldtype": "Link",
   "options": "TruCMMS Component",
   "read_only": 1
  },
  {
   "fieldname": "subject",
   "label": "Trabajo previsto",
   "fieldtype": "Data",
   "in_list_view": 1,
   "read_only": 1
