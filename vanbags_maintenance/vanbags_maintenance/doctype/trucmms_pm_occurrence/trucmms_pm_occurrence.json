  {
   "fieldname": "trigger_total",
   "label": "Umbral de uso",
   "fieldtype": "Float",
   "precision": "6",
   "read_only": 1
  },
  {
   "fieldname": "source_key",
   "label": "Clave de programación",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "sequence",
   "label": "Secuencia",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "procedure_snapshot",
   "label": "Procedimiento aprobado",
   "fieldtype": "Code",
   "options": "JSON",
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "last_reason",
   "label": "Motivo",
   "fieldtype": "Small Text",
   "read_only": 1
  },
  {
   "fieldname": "baseline_before",
   "label": "Base anterior conservada",
   "fieldtype": "Code",
   "options": "JSON",
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "completed_actual_on",
